# 统一换行符，避免 CRLF 污染部署到 Linux 的脚本与配置
# （bash 会报 $'\r': command not found，systemd 解析可能失败）

# 部署相关：强制 LF
deploy/**       text eol=lf
*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf

# 通用文本：保持仓库内 LF
*.py            text eol=lf
*.js            text eol=lf
*.vue           text eol=lf
*.css           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.html          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# 二进制：不转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
