# ============================================
# Legal AI Advisor - 生产环境变量模板
# ============================================
# 复制本文件为 .env：
#   cp .env.production.template .env
# 然后填写真实值。
#
# 必改项（标 ⚠️ 必改）：
#   DASHSCOPE_API_KEY, AUTH_PASSWORD, JWT_SECRET, CORS_ORIGINS
# ============================================

# ---------- ⚠️ 必改：通义千问 / 百炼 API Key ----------
DASHSCOPE_API_KEY=sk-replace-with-your-dashscope-key

# ---------- LLM 模型（一般不用改） ----------
CHAT_MODEL=qwen-turbo
VISION_MODEL=qwen-vl-plus
EMBEDDING_MODEL=text-embedding-v3

# ---------- 服务监听（一般不用改） ----------
HOST=127.0.0.1
PORT=8003

# ---------- ⚠️ 必改：数据目录（绝对路径） ----------
# 安装脚本会自动改成 /opt/legal-ai-advisor/backend/data
# 如手动部署请改成实际路径
DATA_DIR=./data

# ---------- ⚠️ 必改：CORS 允许的来源 ----------
# 多个用英文逗号分隔；不要带路径、不要带尾斜杠
# 示例：https://ai.example.com,https://admin.example.com
CORS_ORIGINS=https://your.domain.com

# ---------- 上传 / 检索 ----------
MAX_UPLOAD_MB=50
MAX_CHAT_IMAGE_MB=5
MAX_CHAT_IMAGES=3
ALLOWED_UPLOAD_EXTENSIONS=.txt,.md,.pdf,.csv,.docx
USE_VECTOR_INDEX=true

# ---------- ⚠️ 必改：JWT 鉴权 ----------
# 安装脚本会生成一个 64 字符的随机值
# 手动部署请用： head -c 48 /dev/urandom | base64 | head -c 64
JWT_SECRET=replace-with-random-64-chars-secret
JWT_EXPIRE_HOURS=72

# ---------- ⚠️ 必改：登录账号（演示环境默认 admin / LegalAi@2026） ----------
AUTH_USERNAME=admin
AUTH_PASSWORD=ChangeMe!2026#Strong
