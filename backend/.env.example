# 阿里云 DashScope API Key（用于 qwen-turbo 与向量嵌入）
# 请到 https://dashscope.aliyun.com/ 创建，勿将真实 Key 提交到 Git
DASHSCOPE_API_KEY=sk-a4eaa5e8fd7e49a3b24e600e7560fb36

# 对话模型
CHAT_MODEL=qwen-turbo

# 图片解读模型（上传图片时自动切换）
VISION_MODEL=qwen-vl-plus

# 嵌入模型（知识库检索）
EMBEDDING_MODEL=text-embedding-v2

# 服务配置
HOST=127.0.0.1
PORT=8002
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 向量检索（FAISS 本地索引，默认开启）
USE_VECTOR_INDEX=true

# 上传限制
MAX_UPLOAD_MB=50
MAX_CHAT_IMAGE_MB=5
MAX_CHAT_IMAGES=3
ALLOWED_UPLOAD_EXTENSIONS=.txt,.md,.pdf,.csv,.docx

# 登录（首次启动自动创建管理员，生产环境务必修改）
JWT_SECRET=please-set-a-random-secret-at-least-32-characters-long
JWT_EXPIRE_HOURS=72
AUTH_USERNAME=admin
AUTH_PASSWORD=LegalAi@2026
